# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored - never commit real secrets.

# Required. Get one at https://openrouter.ai/keys. The agent calls OpenRouter
# directly with this key - it is what lets everything run off the council
# network, with no model server to start. Without it, the agent stops with a
# clear "OPENROUTER_API_KEY is not set" message.
OPENROUTER_API_KEY=

# Which OpenRouter model the agent talks to. Any catalogue id works
# (anthropic/claude-sonnet-4.5, openai/gpt-4o, google/gemini-2.5-flash, ...).
# Defaults to qwen/qwen3.8-27b - the same model the council runs internally,
# which is what the agent's system prompt was written and tuned against.
OPENROUTER_MODEL=qwen/qwen3.8-27b

# Only for the on-VPN "qwen" route, which is reached by running local_ai.py
# and setting API_URL (see the README). Not needed when using OpenRouter.
OWUI_API_KEY=

# Optional. NYC Open Data (used by legistar_search and legislative_text) serves
# anonymous requests on a shared rate limit; a free app token raises it:
#   https://data.cityofnewyork.us/profile/edit/developer_settings
# Nothing breaks without one.
SOCRATA_APP_TOKEN=

# --- Internal council services. Not used by this clone's tools; kept because
# --- mcp/tools/embeddings.py still works on the VPN if you re-register it. ---

# EMBEDDING_API_URL=http://10.250.7.47:8081/v1/embeddings
# EMBEDDING_MODEL=octen-8b
